#!/bin/sh
set -u

BASE='/etc/easyroute'
LISTDIR="$BASE/lists"
RUNDIR='/tmp/easyroute/url-updates'
MAX_BYTES=262144
RESERVE_KB=1024
DEFAULT_INTERVAL=86400

log() { logger -t easyroute-url "$*" 2>/dev/null || true; }
fail() { printf '%s\n' "$*" >&2; return 1; }
valid_id() { printf '%s' "$1" | grep -Eq '^r[0-9A-Za-z_-]+$'; }

rule_ids() {
    uci show easyroute 2>/dev/null | sed -n "s/^easyroute\.\([^.=]*\)=rule$/\1/p"
}

write_status() {
    local id="$1" state="$2" msg="${3:-}" now
    now="$(date +%s)"
    mkdir -p "$RUNDIR"
    printf '%s\n' "$now" > "$RUNDIR/$id.last"
    printf '%s\n' "$state" > "$RUNDIR/$id.state"
    printf '%s\n' "$msg" > "$RUNDIR/$id.message"
}

download_url() {
    local url="$1" out="$2" bytes valid
    case "$url" in
        http://*|https://*) ;;
        *) fail 'Only http:// and https:// URLs are allowed'; return 1 ;;
    esac

    rm -f "$out" "$out.raw"
    if command -v timeout >/dev/null 2>&1; then
        timeout 45 wget -qO "$out.raw" "$url" || {
            rm -f "$out.raw"
            fail 'Failed to download URL'
            return 1
        }
    else
        wget -qO "$out.raw" "$url" || {
            rm -f "$out.raw"
            fail 'Failed to download URL'
            return 1
        }
    fi

    [ -s "$out.raw" ] || {
        rm -f "$out.raw"
        fail 'Remote server returned an empty file'
        return 1
    }

    bytes="$(wc -c < "$out.raw" | tr -d ' ')"
    [ "${bytes:-0}" -le "$MAX_BYTES" ] || {
        rm -f "$out.raw"
        fail "Remote list is larger than 256 KiB (${bytes} bytes)"
        return 1
    }

    if grep -Eiq '<!doctype|<html([ >])|<body([ >])' "$out.raw"; then
        rm -f "$out.raw"
        fail 'Remote server returned HTML instead of a text list'
        return 1
    fi

    tr -d '\r' < "$out.raw" > "$out"
    rm -f "$out.raw"

    valid="$(awk '
      function trim(s){gsub(/^[ \t]+|[ \t]+$/, "", s); return s}
      function octok(x){return (x ~ /^[0-9]+$/ && x+0>=0 && x+0<=255)}
      function ipv4ok(s, a,n,i){n=split(s,a,"."); if(n!=4)return 0; for(i=1;i<=4;i++)if(!octok(a[i]))return 0; return 1}
      {
        gsub(/\r/,"",$0); line=trim($0);
        if(line=="" || line ~ /^#/) next;
        sub(/[ \t]+#.*/, "", line); line=trim(line); if(line=="") next;

        if(line ~ /^route[ \t]+add[ \t]+/){valid++; next}
        if(line ~ /^domain:/) sub(/^domain:/,"",line);
        else if(line ~ /^full:/) sub(/^full:/,"",line);
        else if(line ~ /^(keyword|regexp|include):/) next;

        sub(/^\*\./,"",line);
        sub(/^\./,"",line);

        split(line,a,/[ \t]+/); line=a[1];
        if(line ~ /^[A-Za-z0-9_.-]+$/ || ipv4ok(line) || index(line,":")>0 || index(line,"/")>0) valid++;
      }
      END{print valid+0}
    ' "$out")"

    [ "${valid:-0}" -gt 0 ] || {
        rm -f "$out"
        fail 'No supported entries found in the downloaded file'
        return 1
    }

    return 0
}

check_flash() {
    local newfile="$1" oldfile="$2" newbytes oldbytes delta need_kb free_kb
    newbytes="$(wc -c < "$newfile" | tr -d ' ')"
    oldbytes=0
    [ -f "$oldfile" ] && oldbytes="$(wc -c < "$oldfile" | tr -d ' ')"
    delta=$((newbytes-oldbytes))
    [ "$delta" -lt 0 ] && delta=0
    need_kb=$(((delta+1023)/1024))
    free_kb="$(df -k /overlay 2>/dev/null | awk 'NR==2{print $4}')"
    [ -n "$free_kb" ] || free_kb="$(df -k / 2>/dev/null | awk 'NR==2{print $4}')"
    [ $((free_kb-need_kb)) -ge "$RESERVE_KB" ]
}

update_one_raw() {
    local id="$1" url file tmp msg count
    RULE_CHANGED=0
    valid_id "$id" || { fail 'Invalid rule ID'; return 1; }

    url="$(uci -q get "easyroute.$id.source_url" 2>/dev/null || true)"
    [ -n "$url" ] || { fail 'URL is not configured for this rule'; return 1; }

    mkdir -p "$LISTDIR" "$RUNDIR"
    file="$LISTDIR/$id.txt"
    tmp="/tmp/easyroute-url.$id.$$"

    if ! msg="$(download_url "$url" "$tmp" 2>&1)"; then
        write_status "$id" 'error' "$msg"
        log "$id: $msg"
        rm -f "$tmp"
        fail "$msg"
        return 1
    fi

    if [ -f "$file" ] && cmp -s "$tmp" "$file"; then
        write_status "$id" 'ok' 'No changes'
        rm -f "$tmp"
        printf '%s\n' 'No changes'
        return 0
    fi

    if ! check_flash "$tmp" "$file"; then
        write_status "$id" 'error' 'Not enough flash; previous list kept'
        rm -f "$tmp"
        fail 'Not enough flash. Previous list kept.'
        return 1
    fi

    mv "$tmp" "$file"
    RULE_CHANGED=1
    count="$(awk 'BEGIN{n=0} {gsub(/\r/,""); s=$0; gsub(/^[ \t]+|[ \t]+$/, "", s); if(s!="" && s !~ /^#/)n++} END{print n}' "$file" 2>/dev/null || echo 0)"
    write_status "$id" 'ok' "Updated: ${count:-0} lines"
    log "$id: updated (${count:-0} lines)"
    printf 'Updated: %s lines\n' "${count:-0}"
    return 0
}

is_due() {
    local id="$1" interval last now
    interval="$(uci -q get "easyroute.$id.update_interval" 2>/dev/null || echo "$DEFAULT_INTERVAL")"
    case "$interval" in
        ''|*[!0-9]*) interval="$DEFAULT_INTERVAL" ;;
    esac
    [ "$interval" -ge 3600 ] 2>/dev/null || interval=3600

    last="$(cat "$RUNDIR/$id.last" 2>/dev/null || echo 0)"
    case "$last" in
        ''|*[!0-9]*) last=0 ;;
    esac
    now="$(date +%s)"
    [ $((now-last)) -ge "$interval" ]
}

apply_if_changed() {
    [ "${ANY_CHANGED:-0}" = '1' ] || return 0
    /usr/libexec/easyroute apply
}

update_one() {
    local id="$1"
    [ "$(uci -q get "easyroute.$id" 2>/dev/null || true)" = 'rule' ] || {
        fail 'Rule not found'
        return 1
    }
    [ "$(uci -q get "easyroute.$id.source_type" 2>/dev/null || echo manual)" = 'url' ] || {
        fail 'This is not a URL rule'
        return 1
    }

    if update_one_raw "$id"; then
        if [ "${RULE_CHANGED:-0}" = '1' ]; then
            /usr/libexec/easyroute apply || {
                fail 'List downloaded, but routes could not be applied'
                return 1
            }
        fi
        return 0
    fi
    return 1
}

update_many() {
    local mode="$1" id auto errors=0
    ANY_CHANGED=0
    mkdir -p "$RUNDIR"

    for id in $(rule_ids); do
        [ "$(uci -q get "easyroute.$id.source_type" 2>/dev/null || echo manual)" = 'url' ] || continue

        if [ "$mode" = 'due' ]; then
            auto="$(uci -q get "easyroute.$id.auto_update" 2>/dev/null || echo 1)"
            [ "$auto" = '1' ] || continue
            is_due "$id" || continue
        fi

        if update_one_raw "$id"; then
            [ "${RULE_CHANGED:-0}" = '1' ] && ANY_CHANGED=1
        else
            errors=$((errors+1))
        fi
    done

    if ! apply_if_changed; then
        errors=$((errors+1))
    fi

    if [ "$errors" -gt 0 ]; then
        fail "Update finished with errors: $errors"
        return 1
    fi

    if [ "$ANY_CHANGED" = '1' ]; then
        printf '%s\n' 'URL lists updated and routes applied'
    else
        printf '%s\n' 'URL lists checked; no changes'
    fi
    return 0
}

case "${1:-}" in
    one)
        [ -n "${2:-}" ] || { fail 'Specify rule ID'; exit 2; }
        update_one "$2"
        ;;
    all)
        update_many all
        ;;
    due)
        update_many due
        ;;
    *)
        printf '%s\n' "Usage: $0 one <rule-id> | all | due"
        exit 2
        ;;
esac
