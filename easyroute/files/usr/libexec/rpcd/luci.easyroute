#!/bin/sh

. /usr/share/libubox/jshn.sh

BASE='/etc/easyroute'
LISTDIR="$BASE/lists"
RUNDIR='/tmp/easyroute/url-updates'
MAX_BYTES=262144
RESERVE_KB=1024

reply() {
    json_init
    json_add_boolean ok "$1"
    [ -n "${2:-}" ] && json_add_string message "$2"
    json_dump
}

valid_id() { printf '%s' "$1" | grep -Eq '^[rvd][0-9A-Za-z_-]+

rule_ids() {
    uci show easyroute 2>/dev/null | sed -n "s/^easyroute\.\([^.=]*\)=rule$/\1/p"
}

detect_iface() {
    local configured proto detected
    configured="$(uci -q get easyroute.main.interface 2>/dev/null || true)"
    if [ -n "$configured" ]; then
        proto="$(uci -q get "network.$configured.proto" 2>/dev/null || true)"
        if [ "$proto" = 'amneziawg' ] || ip link show "$configured" >/dev/null 2>&1 || { command -v awg >/dev/null 2>&1 && awg show "$configured" >/dev/null 2>&1; }; then
            printf '%s\n' "$configured"
            return 0
        fi
    fi
    detected="$(uci show network 2>/dev/null | sed -n "s/^network\.\([^.=]*\)\.proto='amneziawg'$/\1/p" | head -n1)"
    if [ -n "$detected" ]; then
        printf '%s\n' "$detected"
    else
        printf '%s\n' "${configured:-AWG}"
    fi
}

status() {
    iface="$(detect_iface)"
    awg_installed=false
    awg_configured=false
    command -v awg >/dev/null 2>&1 && awg_installed=true
    proto="$(uci -q get "network.$iface.proto" 2>/dev/null || true)"
    [ "$proto" = 'amneziawg' ] && awg_configured=true
    command -v awg >/dev/null 2>&1 && awg show "$iface" >/dev/null 2>&1 && awg_configured=true

    out="$(ifstatus "$iface" 2>/dev/null || true)"
    [ -n "$out" ] || out="$(ubus call "network.interface.$iface" status 2>/dev/null || true)"
    up="$(printf '%s' "$out" | jsonfilter -e '@.up' 2>/dev/null || true)"
    ip4="$(printf '%s' "$out" | jsonfilter -e '@["ipv4-address"][0].address' 2>/dev/null || true)"
    [ "$up" = 'true' ] || {
        if ip link show "$iface" >/dev/null 2>&1; then up=true; else up=false; fi
    }
    hs=''
    rx_bytes='0'
    tx_bytes='0'
    if command -v awg >/dev/null 2>&1; then
        ts="$(awg show "$iface" latest-handshakes 2>/dev/null | awk 'NR==1{print $2}')"
        case "$ts" in
            ''|0) : ;;
            *) now="$(date +%s)"; hs="$((now-ts))"; up=true; awg_configured=true ;;
        esac
        transfer="$(awg show "$iface" transfer 2>/dev/null | awk '{rx+=$2; tx+=$3} END{printf "%.0f %.0f", rx+0, tx+0}')"
        rx_bytes="$(printf '%s' "$transfer" | awk '{print $1}')"
        tx_bytes="$(printf '%s' "$transfer" | awk '{print $2}')"
        [ -n "$rx_bytes" ] || rx_bytes='0'
        [ -n "$tx_bytes" ] || tx_bytes='0'
    fi
    total=0; active=0
    for id in $(rule_ids); do
        total=$((total+1))
        [ "$(uci -q get "easyroute.$id.enabled" 2>/dev/null || echo 1)" = '1' ] && active=$((active+1))
    done
    free_kb="$(df -k /overlay 2>/dev/null | awk 'NR==2{print $4}')"
    [ -n "$free_kb" ] || free_kb="$(df -k / 2>/dev/null | awk 'NR==2{print $4}')"
    json_init
    json_add_boolean ok 1
    json_add_string interface "$iface"
    if [ "$awg_installed" = "true" ]; then json_add_boolean awg_installed 1; else json_add_boolean awg_installed 0; fi
    if [ "$awg_configured" = "true" ]; then json_add_boolean awg_configured 1; else json_add_boolean awg_configured 0; fi
    if [ "$up" = "true" ]; then json_add_boolean vpn_up 1; else json_add_boolean vpn_up 0; fi
    json_add_string vpn_ip "$ip4"
    json_add_string handshake_age "$hs"
    json_add_string rx_bytes "$rx_bytes"
    json_add_string tx_bytes "$tx_bytes"
    json_add_int rules "$total"
    json_add_int active "$active"
    json_add_string domain_count "$(cat /tmp/easyroute/domain_count 2>/dev/null || echo 0)"
    json_add_string ip_count "$(cat /tmp/easyroute/ip_count 2>/dev/null || echo 0)"
    json_add_string unsupported_count "$(cat /tmp/easyroute/unsupported_count 2>/dev/null || echo 0)"
    json_add_string invalid_count "$(cat /tmp/easyroute/invalid_count 2>/dev/null || echo 0)"
    json_add_string last_apply "$(cat /tmp/easyroute/last_apply 2>/dev/null || echo '—')"
    json_add_string overlay_free_kb "$free_kb"
    json_dump
}

list_rules() {
    json_init
    json_add_boolean ok 1
    json_add_array rules
    for id in $(rule_ids); do
        name="$(uci -q get "easyroute.$id.name" 2>/dev/null || echo "$id")"
        enabled="$(uci -q get "easyroute.$id.enabled" 2>/dev/null || echo 1)"
        source_type="$(uci -q get "easyroute.$id.source_type" 2>/dev/null || echo manual)"
        source_url="$(uci -q get "easyroute.$id.source_url" 2>/dev/null || true)"
        auto_update="$(uci -q get "easyroute.$id.auto_update" 2>/dev/null || echo 1)"
        update_interval="$(uci -q get "easyroute.$id.update_interval" 2>/dev/null || echo 86400)"
        last_update="$(cat "$RUNDIR/$id.last" 2>/dev/null || echo 0)"
        update_state="$(cat "$RUNDIR/$id.state" 2>/dev/null || true)"
        update_message="$(cat "$RUNDIR/$id.message" 2>/dev/null || true)"
        profile="$(uci -q get "easyroute.$id.profile" 2>/dev/null || true)"
        file="$LISTDIR/$id.txt"
        count="$(awk 'BEGIN{n=0} {gsub(/\r/,""); s=$0; gsub(/^[ \t]+|[ \t]+$/, "", s); if(s!="" && s !~ /^#/)n++} END{print n}' "$file" 2>/dev/null || echo 0)"
        json_add_object ''
        json_add_string id "$id"
        json_add_string name "$name"
        json_add_boolean enabled "$enabled"
        json_add_int count "${count:-0}"
        json_add_string source_type "$source_type"
        json_add_string source_url "$source_url"
        json_add_boolean auto_update "$auto_update"
        json_add_int update_interval "${update_interval:-86400}"
        json_add_string last_update "$last_update"
        json_add_string update_state "$update_state"
        json_add_string update_message "$update_message"
        json_add_string profile "$profile"
        json_close_object
    done
    json_close_array
    json_dump
}

get_rule() {
    json_load "$1"
    json_get_var id id
    valid_id "$id" || { reply 0 'Некорректный ID'; return; }
    [ "$(uci -q get "easyroute.$id" 2>/dev/null || true)" = 'rule' ] || { reply 0 'Список не найден'; return; }
    json_init
    json_add_boolean ok 1
    json_add_string id "$id"
    json_add_string name "$(uci -q get "easyroute.$id.name" 2>/dev/null || echo "$id")"
    json_add_boolean enabled "$(uci -q get "easyroute.$id.enabled" 2>/dev/null || echo 1)"
    json_add_string content "$(cat "$LISTDIR/$id.txt" 2>/dev/null || true)"
    json_add_string source_type "$(uci -q get "easyroute.$id.source_type" 2>/dev/null || echo manual)"
    json_add_string source_url "$(uci -q get "easyroute.$id.source_url" 2>/dev/null || true)"
    json_add_boolean auto_update "$(uci -q get "easyroute.$id.auto_update" 2>/dev/null || echo 1)"
    json_add_int update_interval "$(uci -q get "easyroute.$id.update_interval" 2>/dev/null || echo 86400)"
    json_add_string last_update "$(cat "$RUNDIR/$id.last" 2>/dev/null || echo 0)"
    json_add_string update_state "$(cat "$RUNDIR/$id.state" 2>/dev/null || true)"
    json_add_string update_message "$(cat "$RUNDIR/$id.message" 2>/dev/null || true)"
    json_add_string profile "$(uci -q get "easyroute.$id.profile" 2>/dev/null || true)"
    json_dump
}

save_rule() {
    json_load "$1"
    json_get_var id id
    json_get_var name name
    json_get_var enabled enabled
    json_get_var content content
    json_get_var source_type source_type
    json_get_var source_url source_url
    json_get_var auto_update auto_update
    json_get_var update_interval update_interval
    json_get_var profile profile

    name="$(printf '%s' "$name" | tr '\r\n' '  ' | cut -c1-80)"
    [ -n "$name" ] || { reply 0 'Укажите название'; return; }

    case "$source_type" in
        url) ;;
        *) source_type='manual' ;;
    esac
    case "$enabled" in 0|false) enabled=0 ;; *) enabled=1 ;; esac
    case "$auto_update" in 0|false) auto_update=0 ;; *) auto_update=1 ;; esac
    case "$update_interval" in ''|*[!0-9]*) update_interval=86400 ;; esac
    [ "$update_interval" -ge 3600 ] 2>/dev/null || update_interval=3600

    is_new=0
    if [ -z "$id" ]; then
        is_new=1
        id="r$(date +%s)$"
    fi
    valid_id "$id" || { reply 0 'Некорректный ID'; return; }

    if [ "$source_type" = 'url' ]; then
        source_url="$(printf '%s' "$source_url" | tr -d '\r\n' | cut -c1-2048)"
        case "$source_url" in
            http://*|https://*) ;;
            *) reply 0 'URL должен начинаться с http:// или https://'; return ;;
        esac

        uci -q delete "easyroute.$id" 2>/dev/null || true
        uci set "easyroute.$id=rule"
        uci set "easyroute.$id.name=$name"
        uci set "easyroute.$id.enabled=$enabled"
        uci set "easyroute.$id.source_type=url"
        uci set "easyroute.$id.source_url=$source_url"
        uci set "easyroute.$id.auto_update=$auto_update"
        uci set "easyroute.$id.update_interval=$update_interval"
        [ -n "$profile" ] && uci set "easyroute.$id.profile=$profile"
        uci commit easyroute

        if out="$(/usr/libexec/easyroute-url-update one "$id" 2>&1)"; then
            reply 1 "URL сохранён и обновлён: $out"
        else
            if [ "$is_new" = '1' ]; then
                uci -q delete "easyroute.$id" 2>/dev/null || true
                uci commit easyroute
                rm -f "$LISTDIR/$id.txt" "$RUNDIR/$id.last" "$RUNDIR/$id.state" "$RUNDIR/$id.message"
                reply 0 "Не удалось добавить URL-список: $out"
            else
                reply 0 "URL сохранён, но обновить список не удалось. Старый список сохранён: $out"
            fi
        fi
        return
    fi

    bytes="$(printf '%s' "$content" | wc -c | tr -d ' ')"
    [ "$bytes" -le "$MAX_BYTES" ] || { reply 0 'TXT больше 256 КБ. Для этого роутера список слишком большой.'; return; }

    oldbytes=0
    [ -f "$LISTDIR/$id.txt" ] && oldbytes="$(wc -c < "$LISTDIR/$id.txt" | tr -d ' ')"
    delta=$((bytes-oldbytes))
    [ "$delta" -lt 0 ] && delta=0
    need_kb=$(((delta+1023)/1024))
    free_kb="$(df -k /overlay 2>/dev/null | awk 'NR==2{print $4}')"
    [ -n "$free_kb" ] || free_kb="$(df -k / 2>/dev/null | awk 'NR==2{print $4}')"
    [ $((free_kb-need_kb)) -ge "$RESERVE_KB" ] || { reply 0 'Недостаточно flash. EasyRoute оставляет минимум 1 МБ свободным.'; return; }

    mkdir -p "$LISTDIR"
    tmp="$LISTDIR/.$id.tmp.$$"
    printf '%s\n' "$content" | tr -d '\r' > "$tmp"
    mv "$tmp" "$LISTDIR/$id.txt"

    uci -q delete "easyroute.$id" 2>/dev/null || true
    uci set "easyroute.$id=rule"
    uci set "easyroute.$id.name=$name"
    uci set "easyroute.$id.enabled=$enabled"
    uci set "easyroute.$id.source_type=manual"
    [ -n "$profile" ] && uci set "easyroute.$id.profile=$profile"
    uci commit easyroute
    rm -f "$RUNDIR/$id.last" "$RUNDIR/$id.state" "$RUNDIR/$id.message"

    if out="$(/usr/libexec/easyroute apply 2>&1)"; then
        reply 1 'Сохранено и применено'
    else
        reply 0 "Список сохранён, но не применён: $out"
    fi
}

delete_rule() {
    json_load "$1"; json_get_var id id
    valid_id "$id" || { reply 0 'Некорректный ID'; return; }
    uci -q delete "easyroute.$id" 2>/dev/null || true
    uci commit easyroute
    rm -f "$LISTDIR/$id.txt" "$RUNDIR/$id.last" "$RUNDIR/$id.state" "$RUNDIR/$id.message"
    if out="$(/usr/libexec/easyroute apply 2>&1)"; then reply 1 'Удалено'; else reply 0 "Удалено, но применение завершилось ошибкой: $out"; fi
}


profiles() {
    json_init
    json_add_boolean ok 1
    json_add_array profiles
    if [ -z "$(uci show easyroute 2>/dev/null | sed -n "s/^easyroute\.\([^.=]*\)=vpn$/\1/p")" ]; then
        id='__default'
        iface="$(detect_iface)"
        up=0; iface_status=''
        command -v awg >/dev/null 2>&1 && awg show "$iface" >/dev/null 2>&1 && up=1
        json_add_object ''
        json_add_string id "$id"
        json_add_string name 'Основной AWG'
        json_add_string interface "$iface"
        json_add_string mark '0x66'
        json_add_int table 166
        json_add_boolean enabled 1
        json_add_boolean up "$up"
        json_close_object
    else
        for id in $(uci show easyroute 2>/dev/null | sed -n "s/^easyroute\.\([^.=]*\)=vpn$/\1/p"); do
            iface="$(uci -q get "easyroute.$id.interface" 2>/dev/null || true)"
            up=0
            command -v awg >/dev/null 2>&1 && awg show "$iface" >/dev/null 2>&1 && up=1
            json_add_object ''
            json_add_string id "$id"
            json_add_string name "$(uci -q get "easyroute.$id.name" 2>/dev/null || echo "$id")"
            json_add_string interface "$iface"
            json_add_string mark "$(uci -q get "easyroute.$id.mark" 2>/dev/null || echo 0x66)"
            json_add_int table "$(uci -q get "easyroute.$id.table" 2>/dev/null || echo 166)"
            json_add_boolean enabled "$(uci -q get "easyroute.$id.enabled" 2>/dev/null || echo 1)"
            json_add_boolean up "$up"
            json_close_object
        done
    fi
    json_close_array
    json_dump
}

save_profile() {
    json_load "$1"
    json_get_var id id
    json_get_var name name
    json_get_var interface interface
    json_get_var mark mark
    json_get_var table table
    json_get_var enabled enabled
    name="$(printf '%s' "$name" | tr '\r\n' ' ' | cut -c1-80)"
    [ -n "$name" ] || { reply 0 'Укажите название VPN'; return; }
    [ -n "$interface" ] || { reply 0 'Укажите интерфейс AmneziaWG'; return; }
    case "$mark" in 0x[0-9A-Fa-f]*|[0-9]*) ;; *) reply 0 'Некорректный mark'; return ;; esac
    case "$table" in ''|*[!0-9]*) reply 0 'Некорректная таблица'; return ;; esac
    [ "$table" -ge 1 ] 2>/dev/null && [ "$table" -le 252 ] 2>/dev/null || { reply 0 'Таблица должна быть 1..252'; return; }
    [ "$enabled" = 0 ] && enabled=0 || enabled=1
    if [ -z "$id" ] || [ "$id" = '__default' ]; then id="v$(date +%s)$$"; fi
    valid_id "$id" || { reply 0 'Некорректный ID'; return; }
    uci set "easyroute.$id=vpn"
    uci set "easyroute.$id.name=$name"
    uci set "easyroute.$id.interface=$interface"
    uci set "easyroute.$id.mark=$mark"
    uci set "easyroute.$id.table=$table"
    uci set "easyroute.$id.enabled=$enabled"
    if [ -z "$(uci -q get easyroute.main.profile 2>/dev/null || true)" ]; then uci set "easyroute.main.profile=$id"; fi
    uci commit easyroute
    if out="$(/usr/libexec/easyroute apply 2>&1)"; then reply 1 'VPN-профиль сохранён и применён'; else reply 0 "$out"; fi
}

delete_profile() {
    json_load "$1"; json_get_var id id
    valid_id "$id" || { reply 0 'Некорректный ID'; return; }
    [ "$(uci -q get "easyroute.$id" 2>/dev/null || true)" = vpn ] || { reply 0 'Профиль не найден'; return; }
    uci -q delete "easyroute.$id" 2>/dev/null || true
    if [ "$(uci -q get easyroute.main.profile 2>/dev/null || true)" = "$id" ]; then uci -q delete easyroute.main.profile; fi
    uci commit easyroute
    /usr/libexec/easyroute apply >/dev/null 2>&1 || true
    reply 1 'VPN-профиль удалён'
}

devices() {
    json_init
    json_add_boolean ok 1
    json_add_array devices
    for id in $(device_ids); do
        json_add_object ''
        json_add_string id "$id"
        json_add_string name "$(uci -q get "easyroute.$id.name" 2>/dev/null || echo "$id")"
        json_add_string mac "$(uci -q get "easyroute.$id.mac" 2>/dev/null || true)"
        json_add_string profile "$(uci -q get "easyroute.$id.profile" 2>/dev/null || true)"
        json_add_boolean enabled "$(uci -q get "easyroute.$id.enabled" 2>/dev/null || echo 1)"
        json_close_object
    done
    json_close_array
    json_dump
}

save_device() {
    json_load "$1"; json_get_var id id; json_get_var name name; json_get_var mac mac; json_get_var profile profile; json_get_var enabled enabled
    name="$(printf '%s' "$name" | tr '\r\n' ' ' | cut -c1-80)"
    mac="$(printf '%s' "$mac" | tr '[:lower:]' '[:upper:]' | tr -d '\r\n')"
    printf '%s' "$mac" | grep -Eq '^[0-9A-F]{2}(:[0-9A-F]{2}){5}$' || { reply 0 'Некорректный MAC'; return; }
    if [ -z "$id" ]; then id="d$(date +%s)$$"; fi
    valid_id "$id" || { reply 0 'Некорректный ID'; return; }
    [ "$enabled" = 0 ] && enabled=0 || enabled=1
    uci set "easyroute.$id=device"
    uci set "easyroute.$id.name=$name"
    uci set "easyroute.$id.mac=$mac"
    [ -n "$profile" ] && uci set "easyroute.$id.profile=$profile" || uci -q delete "easyroute.$id.profile"
    uci set "easyroute.$id.enabled=$enabled"
    uci commit easyroute
    if out="$(/usr/libexec/easyroute apply 2>&1)"; then reply 1 'Устройство сохранено и применено'; else reply 0 "$out"; fi
}

delete_device() {
    json_load "$1"; json_get_var id id; valid_id "$id" || { reply 0 'Некорректный ID'; return; }
    uci -q delete "easyroute.$id" 2>/dev/null || true; uci commit easyroute
    /usr/libexec/easyroute apply >/dev/null 2>&1 || true
    reply 1 'Устройство удалено'
}

test_route() {
    json_load "$1"; json_get_var host host; json_get_var profile profile
    host="$(printf '%s' "$host" | tr -d '\r\n' | cut -c1-255)"
    [ -n "$host" ] || { reply 0 'Введите домен или IP'; return; }
    if printf '%s' "$host" | grep -Eq '^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$'; then
        ip="$host"
    else
        ip="$(nslookup "$host" 127.0.0.1 2>/dev/null | awk '/^Address [0-9]+: /{print $3} /^Address: /{print $2}' | grep -E '^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$' | head -n1)"
    fi
    [ -n "$ip" ] || { reply 0 'DNS не вернул IPv4-адрес'; return; }
    [ -n "$profile" ] || profile="$(uci -q get easyroute.main.profile 2>/dev/null || true)"
    [ -n "$profile" ] || profile="$(vpn_ids | head -n1)"
    [ -n "$profile" ] || profile='__default'
    if [ "$profile" = '__default' ]; then mark='0x66'; iface="$(detect_iface)"; name='Основной AWG'
    else mark="$(uci -q get "easyroute.$profile.mark" 2>/dev/null || echo 0x66)"; iface="$(uci -q get "easyroute.$profile.interface" 2>/dev/null || true)"; name="$(uci -q get "easyroute.$profile.name" 2>/dev/null || echo "$profile")"; fi
    route="$(ip route get "$ip" mark "$mark" 2>/dev/null || true)"
    json_init; json_add_boolean ok 1; json_add_string host "$host"; json_add_string ip "$ip"; json_add_string profile "$name"; json_add_string interface "$iface"; json_add_string mark "$mark"; json_add_string route "$route"; json_dump
}

diagnostics() {
    json_init; json_add_boolean ok 1
    json_add_string openwrt "$(grep -o "DISTRIB_RELEASE='[^']*'" /etc/openwrt_release 2>/dev/null | cut -d"'" -f2)"
    json_add_string awg_version "$(awg --version 2>/dev/null | head -n1 || echo not-installed)"
    json_add_string firewall "$(fw4 -q check >/dev/null 2>&1 && echo OK || echo ERROR)"
    json_add_string dnsmasq "$(dnsmasq --test --conf-file=/etc/dnsmasq.conf >/dev/null 2>&1 && echo OK || echo ERROR)"
    json_add_string iface "$(detect_iface)"
    json_add_string ip_rules "$(ip rule show 2>/dev/null | tr '\n' ';' | cut -c1-1800)"
    json_add_string routes "$(ip route show table 166 2>/dev/null | tr '\n' ';' | cut -c1-1000)"
    json_add_string nft "$(nft list table inet fw4 2>/dev/null | grep -c easyroute || echo 0)"
    json_add_string log "$(tail -n 30 /tmp/easyroute-fw4.log 2>/dev/null | tr '\n' ' ' | cut -c1-1500)"
    json_dump
}

case "${1:-}" in
    list)
        json_init
        json_add_object status; json_close_object
        json_add_object list_rules; json_close_object
        json_add_object get_rule; json_add_string id String; json_close_object
        json_add_object save_rule
            json_add_string id String
            json_add_string name String
            json_add_boolean enabled Boolean
            json_add_string content String
            json_add_string source_type String
            json_add_string source_url String
            json_add_boolean auto_update Boolean
            json_add_string update_interval String
            json_add_string profile String
        json_close_object
        json_add_object profiles; json_close_object
        json_add_object save_profile
            json_add_string id String
            json_add_string name String
            json_add_string interface String
            json_add_string mark String
            json_add_string table String
            json_add_boolean enabled Boolean
        json_close_object
        json_add_object delete_profile; json_add_string id String; json_close_object
        json_add_object devices; json_close_object
        json_add_object save_device
            json_add_string id String
            json_add_string name String
            json_add_string mac String
            json_add_string profile String
            json_add_boolean enabled Boolean
        json_close_object
        json_add_object delete_device; json_add_string id String; json_close_object
        json_add_object test_route
            json_add_string host String
            json_add_string profile String
        json_close_object
        json_add_object diagnostics; json_close_object
        json_add_object delete_rule; json_add_string id String; json_close_object
        json_add_object update_rule; json_add_string id String; json_close_object
        json_add_object update_all; json_close_object
        json_add_object apply; json_close_object
        json_dump
        ;;
    call)
        method="${2:-}"; payload="$(cat)"
        case "$method" in
            status) status ;;
            list_rules) list_rules ;;
            get_rule) get_rule "$payload" ;;
            save_rule) save_rule "$payload" ;;
            delete_rule) delete_rule "$payload" ;;
            update_rule)
                json_load "$payload"; json_get_var id id
                valid_id "$id" || { reply 0 'Некорректный ID'; exit 0; }
                if out="$(/usr/libexec/easyroute-url-update one "$id" 2>&1)"; then reply 1 "$out"; else reply 0 "$out"; fi
                ;;
            update_all)
                if out="$(/usr/libexec/easyroute-url-update all 2>&1)"; then reply 1 "$out"; else reply 0 "$out"; fi
                ;;
            profiles) profiles ;;
            save_profile) save_profile "$payload" ;;
            delete_profile) delete_profile "$payload" ;;
            devices) devices ;;
            save_device) save_device "$payload" ;;
            delete_device) delete_device "$payload" ;;
            test_route) test_route "$payload" ;;
            diagnostics) diagnostics ;;
            apply)
                if out="$(/usr/libexec/easyroute apply 2>&1)"; then reply 1 'Маршруты применены'; else reply 0 "$out"; fi
                ;;
            *) reply 0 'Неизвестная команда' ;;
        esac
        ;;
esac
; }

rule_ids() {
    uci show easyroute 2>/dev/null | sed -n "s/^easyroute\.\([^.=]*\)=rule$/\1/p"
}

detect_iface() {
    local configured proto detected
    configured="$(uci -q get easyroute.main.interface 2>/dev/null || true)"
    if [ -n "$configured" ]; then
        proto="$(uci -q get "network.$configured.proto" 2>/dev/null || true)"
        if [ "$proto" = 'amneziawg' ] || ip link show "$configured" >/dev/null 2>&1 || { command -v awg >/dev/null 2>&1 && awg show "$configured" >/dev/null 2>&1; }; then
            printf '%s\n' "$configured"
            return 0
        fi
    fi
    detected="$(uci show network 2>/dev/null | sed -n "s/^network\.\([^.=]*\)\.proto='amneziawg'$/\1/p" | head -n1)"
    if [ -n "$detected" ]; then
        printf '%s\n' "$detected"
    else
        printf '%s\n' "${configured:-AWG}"
    fi
}

status() {
    iface="$(detect_iface)"
    awg_installed=false
    awg_configured=false
    command -v awg >/dev/null 2>&1 && awg_installed=true
    proto="$(uci -q get "network.$iface.proto" 2>/dev/null || true)"
    [ "$proto" = 'amneziawg' ] && awg_configured=true
    command -v awg >/dev/null 2>&1 && awg show "$iface" >/dev/null 2>&1 && awg_configured=true

    out="$(ifstatus "$iface" 2>/dev/null || true)"
    [ -n "$out" ] || out="$(ubus call "network.interface.$iface" status 2>/dev/null || true)"
    up="$(printf '%s' "$out" | jsonfilter -e '@.up' 2>/dev/null || true)"
    ip4="$(printf '%s' "$out" | jsonfilter -e '@["ipv4-address"][0].address' 2>/dev/null || true)"
    [ "$up" = 'true' ] || {
        if ip link show "$iface" >/dev/null 2>&1; then up=true; else up=false; fi
    }
    hs=''
    rx_bytes='0'
    tx_bytes='0'
    if command -v awg >/dev/null 2>&1; then
        ts="$(awg show "$iface" latest-handshakes 2>/dev/null | awk 'NR==1{print $2}')"
        case "$ts" in
            ''|0) : ;;
            *) now="$(date +%s)"; hs="$((now-ts))"; up=true; awg_configured=true ;;
        esac
        transfer="$(awg show "$iface" transfer 2>/dev/null | awk '{rx+=$2; tx+=$3} END{printf "%.0f %.0f", rx+0, tx+0}')"
        rx_bytes="$(printf '%s' "$transfer" | awk '{print $1}')"
        tx_bytes="$(printf '%s' "$transfer" | awk '{print $2}')"
        [ -n "$rx_bytes" ] || rx_bytes='0'
        [ -n "$tx_bytes" ] || tx_bytes='0'
    fi
    total=0; active=0
    for id in $(rule_ids); do
        total=$((total+1))
        [ "$(uci -q get "easyroute.$id.enabled" 2>/dev/null || echo 1)" = '1' ] && active=$((active+1))
    done
    free_kb="$(df -k /overlay 2>/dev/null | awk 'NR==2{print $4}')"
    [ -n "$free_kb" ] || free_kb="$(df -k / 2>/dev/null | awk 'NR==2{print $4}')"
    json_init
    json_add_boolean ok 1
    json_add_string interface "$iface"
    if [ "$awg_installed" = "true" ]; then json_add_boolean awg_installed 1; else json_add_boolean awg_installed 0; fi
    if [ "$awg_configured" = "true" ]; then json_add_boolean awg_configured 1; else json_add_boolean awg_configured 0; fi
    if [ "$up" = "true" ]; then json_add_boolean vpn_up 1; else json_add_boolean vpn_up 0; fi
    json_add_string vpn_ip "$ip4"
    json_add_string handshake_age "$hs"
    json_add_string rx_bytes "$rx_bytes"
    json_add_string tx_bytes "$tx_bytes"
    json_add_int rules "$total"
    json_add_int active "$active"
    json_add_string domain_count "$(cat /tmp/easyroute/domain_count 2>/dev/null || echo 0)"
    json_add_string ip_count "$(cat /tmp/easyroute/ip_count 2>/dev/null || echo 0)"
    json_add_string unsupported_count "$(cat /tmp/easyroute/unsupported_count 2>/dev/null || echo 0)"
    json_add_string invalid_count "$(cat /tmp/easyroute/invalid_count 2>/dev/null || echo 0)"
    json_add_string last_apply "$(cat /tmp/easyroute/last_apply 2>/dev/null || echo '—')"
    json_add_string overlay_free_kb "$free_kb"
    json_dump
}

list_rules() {
    json_init
    json_add_boolean ok 1
    json_add_array rules
    for id in $(rule_ids); do
        name="$(uci -q get "easyroute.$id.name" 2>/dev/null || echo "$id")"
        enabled="$(uci -q get "easyroute.$id.enabled" 2>/dev/null || echo 1)"
        source_type="$(uci -q get "easyroute.$id.source_type" 2>/dev/null || echo manual)"
        source_url="$(uci -q get "easyroute.$id.source_url" 2>/dev/null || true)"
        auto_update="$(uci -q get "easyroute.$id.auto_update" 2>/dev/null || echo 1)"
        update_interval="$(uci -q get "easyroute.$id.update_interval" 2>/dev/null || echo 86400)"
        last_update="$(cat "$RUNDIR/$id.last" 2>/dev/null || echo 0)"
        update_state="$(cat "$RUNDIR/$id.state" 2>/dev/null || true)"
        update_message="$(cat "$RUNDIR/$id.message" 2>/dev/null || true)"
        profile="$(uci -q get "easyroute.$id.profile" 2>/dev/null || true)"
        file="$LISTDIR/$id.txt"
        count="$(awk 'BEGIN{n=0} {gsub(/\r/,""); s=$0; gsub(/^[ \t]+|[ \t]+$/, "", s); if(s!="" && s !~ /^#/)n++} END{print n}' "$file" 2>/dev/null || echo 0)"
        json_add_object ''
        json_add_string id "$id"
        json_add_string name "$name"
        json_add_boolean enabled "$enabled"
        json_add_int count "${count:-0}"
        json_add_string source_type "$source_type"
        json_add_string source_url "$source_url"
        json_add_boolean auto_update "$auto_update"
        json_add_int update_interval "${update_interval:-86400}"
        json_add_string last_update "$last_update"
        json_add_string update_state "$update_state"
        json_add_string update_message "$update_message"
        json_add_string profile "$profile"
        json_close_object
    done
    json_close_array
    json_dump
}

get_rule() {
    json_load "$1"
    json_get_var id id
    valid_id "$id" || { reply 0 'Некорректный ID'; return; }
    [ "$(uci -q get "easyroute.$id" 2>/dev/null || true)" = 'rule' ] || { reply 0 'Список не найден'; return; }
    json_init
    json_add_boolean ok 1
    json_add_string id "$id"
    json_add_string name "$(uci -q get "easyroute.$id.name" 2>/dev/null || echo "$id")"
    json_add_boolean enabled "$(uci -q get "easyroute.$id.enabled" 2>/dev/null || echo 1)"
    json_add_string content "$(cat "$LISTDIR/$id.txt" 2>/dev/null || true)"
    json_add_string source_type "$(uci -q get "easyroute.$id.source_type" 2>/dev/null || echo manual)"
    json_add_string source_url "$(uci -q get "easyroute.$id.source_url" 2>/dev/null || true)"
    json_add_boolean auto_update "$(uci -q get "easyroute.$id.auto_update" 2>/dev/null || echo 1)"
    json_add_int update_interval "$(uci -q get "easyroute.$id.update_interval" 2>/dev/null || echo 86400)"
    json_add_string last_update "$(cat "$RUNDIR/$id.last" 2>/dev/null || echo 0)"
    json_add_string update_state "$(cat "$RUNDIR/$id.state" 2>/dev/null || true)"
    json_add_string update_message "$(cat "$RUNDIR/$id.message" 2>/dev/null || true)"
    json_add_string profile "$(uci -q get "easyroute.$id.profile" 2>/dev/null || true)"
    json_dump
}

save_rule() {
    json_load "$1"
    json_get_var id id
    json_get_var name name
    json_get_var enabled enabled
    json_get_var content content
    json_get_var source_type source_type
    json_get_var source_url source_url
    json_get_var auto_update auto_update
    json_get_var update_interval update_interval
    json_get_var profile profile

    name="$(printf '%s' "$name" | tr '\r\n' '  ' | cut -c1-80)"
    [ -n "$name" ] || { reply 0 'Укажите название'; return; }

    case "$source_type" in
        url) ;;
        *) source_type='manual' ;;
    esac
    case "$enabled" in 0|false) enabled=0 ;; *) enabled=1 ;; esac
    case "$auto_update" in 0|false) auto_update=0 ;; *) auto_update=1 ;; esac
    case "$update_interval" in ''|*[!0-9]*) update_interval=86400 ;; esac
    [ "$update_interval" -ge 3600 ] 2>/dev/null || update_interval=3600

    is_new=0
    if [ -z "$id" ]; then
        is_new=1
        id="r$(date +%s)$"
    fi
    valid_id "$id" || { reply 0 'Некорректный ID'; return; }

    if [ "$source_type" = 'url' ]; then
        source_url="$(printf '%s' "$source_url" | tr -d '\r\n' | cut -c1-2048)"
        case "$source_url" in
            http://*|https://*) ;;
            *) reply 0 'URL должен начинаться с http:// или https://'; return ;;
        esac

        uci -q delete "easyroute.$id" 2>/dev/null || true
        uci set "easyroute.$id=rule"
        uci set "easyroute.$id.name=$name"
        uci set "easyroute.$id.enabled=$enabled"
        uci set "easyroute.$id.source_type=url"
        uci set "easyroute.$id.source_url=$source_url"
        uci set "easyroute.$id.auto_update=$auto_update"
        uci set "easyroute.$id.update_interval=$update_interval"
        [ -n "$profile" ] && uci set "easyroute.$id.profile=$profile"
        uci commit easyroute

        if out="$(/usr/libexec/easyroute-url-update one "$id" 2>&1)"; then
            reply 1 "URL сохранён и обновлён: $out"
        else
            if [ "$is_new" = '1' ]; then
                uci -q delete "easyroute.$id" 2>/dev/null || true
                uci commit easyroute
                rm -f "$LISTDIR/$id.txt" "$RUNDIR/$id.last" "$RUNDIR/$id.state" "$RUNDIR/$id.message"
                reply 0 "Не удалось добавить URL-список: $out"
            else
                reply 0 "URL сохранён, но обновить список не удалось. Старый список сохранён: $out"
            fi
        fi
        return
    fi

    bytes="$(printf '%s' "$content" | wc -c | tr -d ' ')"
    [ "$bytes" -le "$MAX_BYTES" ] || { reply 0 'TXT больше 256 КБ. Для этого роутера список слишком большой.'; return; }

    oldbytes=0
    [ -f "$LISTDIR/$id.txt" ] && oldbytes="$(wc -c < "$LISTDIR/$id.txt" | tr -d ' ')"
    delta=$((bytes-oldbytes))
    [ "$delta" -lt 0 ] && delta=0
    need_kb=$(((delta+1023)/1024))
    free_kb="$(df -k /overlay 2>/dev/null | awk 'NR==2{print $4}')"
    [ -n "$free_kb" ] || free_kb="$(df -k / 2>/dev/null | awk 'NR==2{print $4}')"
    [ $((free_kb-need_kb)) -ge "$RESERVE_KB" ] || { reply 0 'Недостаточно flash. EasyRoute оставляет минимум 1 МБ свободным.'; return; }

    mkdir -p "$LISTDIR"
    tmp="$LISTDIR/.$id.tmp.$$"
    printf '%s\n' "$content" | tr -d '\r' > "$tmp"
    mv "$tmp" "$LISTDIR/$id.txt"

    uci -q delete "easyroute.$id" 2>/dev/null || true
    uci set "easyroute.$id=rule"
    uci set "easyroute.$id.name=$name"
    uci set "easyroute.$id.enabled=$enabled"
    uci set "easyroute.$id.source_type=manual"
    [ -n "$profile" ] && uci set "easyroute.$id.profile=$profile"
    uci commit easyroute
    rm -f "$RUNDIR/$id.last" "$RUNDIR/$id.state" "$RUNDIR/$id.message"

    if out="$(/usr/libexec/easyroute apply 2>&1)"; then
        reply 1 'Сохранено и применено'
    else
        reply 0 "Список сохранён, но не применён: $out"
    fi
}

delete_rule() {
    json_load "$1"; json_get_var id id
    valid_id "$id" || { reply 0 'Некорректный ID'; return; }
    uci -q delete "easyroute.$id" 2>/dev/null || true
    uci commit easyroute
    rm -f "$LISTDIR/$id.txt" "$RUNDIR/$id.last" "$RUNDIR/$id.state" "$RUNDIR/$id.message"
    if out="$(/usr/libexec/easyroute apply 2>&1)"; then reply 1 'Удалено'; else reply 0 "Удалено, но применение завершилось ошибкой: $out"; fi
}


profiles() {
    json_init
    json_add_boolean ok 1
    json_add_array profiles
    if [ -z "$(uci show easyroute 2>/dev/null | sed -n "s/^easyroute\.\([^.=]*\)=vpn$/\1/p")" ]; then
        id='__default'
        iface="$(detect_iface)"
        up=0; iface_status=''
        command -v awg >/dev/null 2>&1 && awg show "$iface" >/dev/null 2>&1 && up=1
        json_add_object ''
        json_add_string id "$id"
        json_add_string name 'Основной AWG'
        json_add_string interface "$iface"
        json_add_string mark '0x66'
        json_add_int table 166
        json_add_boolean enabled 1
        json_add_boolean up "$up"
        json_close_object
    else
        for id in $(uci show easyroute 2>/dev/null | sed -n "s/^easyroute\.\([^.=]*\)=vpn$/\1/p"); do
            iface="$(uci -q get "easyroute.$id.interface" 2>/dev/null || true)"
            up=0
            command -v awg >/dev/null 2>&1 && awg show "$iface" >/dev/null 2>&1 && up=1
            json_add_object ''
            json_add_string id "$id"
            json_add_string name "$(uci -q get "easyroute.$id.name" 2>/dev/null || echo "$id")"
            json_add_string interface "$iface"
            json_add_string mark "$(uci -q get "easyroute.$id.mark" 2>/dev/null || echo 0x66)"
            json_add_int table "$(uci -q get "easyroute.$id.table" 2>/dev/null || echo 166)"
            json_add_boolean enabled "$(uci -q get "easyroute.$id.enabled" 2>/dev/null || echo 1)"
            json_add_boolean up "$up"
            json_close_object
        done
    fi
    json_close_array
    json_dump
}

save_profile() {
    json_load "$1"
    json_get_var id id
    json_get_var name name
    json_get_var interface interface
    json_get_var mark mark
    json_get_var table table
    json_get_var enabled enabled
    name="$(printf '%s' "$name" | tr '\r\n' ' ' | cut -c1-80)"
    [ -n "$name" ] || { reply 0 'Укажите название VPN'; return; }
    [ -n "$interface" ] || { reply 0 'Укажите интерфейс AmneziaWG'; return; }
    case "$mark" in 0x[0-9A-Fa-f]*|[0-9]*) ;; *) reply 0 'Некорректный mark'; return ;; esac
    case "$table" in ''|*[!0-9]*) reply 0 'Некорректная таблица'; return ;; esac
    [ "$table" -ge 1 ] 2>/dev/null && [ "$table" -le 252 ] 2>/dev/null || { reply 0 'Таблица должна быть 1..252'; return; }
    [ "$enabled" = 0 ] && enabled=0 || enabled=1
    if [ -z "$id" ] || [ "$id" = '__default' ]; then id="v$(date +%s)$$"; fi
    valid_id "$id" || { reply 0 'Некорректный ID'; return; }
    uci set "easyroute.$id=vpn"
    uci set "easyroute.$id.name=$name"
    uci set "easyroute.$id.interface=$interface"
    uci set "easyroute.$id.mark=$mark"
    uci set "easyroute.$id.table=$table"
    uci set "easyroute.$id.enabled=$enabled"
    if [ -z "$(uci -q get easyroute.main.profile 2>/dev/null || true)" ]; then uci set "easyroute.main.profile=$id"; fi
    uci commit easyroute
    if out="$(/usr/libexec/easyroute apply 2>&1)"; then reply 1 'VPN-профиль сохранён и применён'; else reply 0 "$out"; fi
}

delete_profile() {
    json_load "$1"; json_get_var id id
    valid_id "$id" || { reply 0 'Некорректный ID'; return; }
    [ "$(uci -q get "easyroute.$id" 2>/dev/null || true)" = vpn ] || { reply 0 'Профиль не найден'; return; }
    uci -q delete "easyroute.$id" 2>/dev/null || true
    if [ "$(uci -q get easyroute.main.profile 2>/dev/null || true)" = "$id" ]; then uci -q delete easyroute.main.profile; fi
    uci commit easyroute
    /usr/libexec/easyroute apply >/dev/null 2>&1 || true
    reply 1 'VPN-профиль удалён'
}

devices() {
    json_init
    json_add_boolean ok 1
    json_add_array devices
    for id in $(device_ids); do
        json_add_object ''
        json_add_string id "$id"
        json_add_string name "$(uci -q get "easyroute.$id.name" 2>/dev/null || echo "$id")"
        json_add_string mac "$(uci -q get "easyroute.$id.mac" 2>/dev/null || true)"
        json_add_string profile "$(uci -q get "easyroute.$id.profile" 2>/dev/null || true)"
        json_add_boolean enabled "$(uci -q get "easyroute.$id.enabled" 2>/dev/null || echo 1)"
        json_close_object
    done
    json_close_array
    json_dump
}

save_device() {
    json_load "$1"; json_get_var id id; json_get_var name name; json_get_var mac mac; json_get_var profile profile; json_get_var enabled enabled
    name="$(printf '%s' "$name" | tr '\r\n' ' ' | cut -c1-80)"
    mac="$(printf '%s' "$mac" | tr '[:lower:]' '[:upper:]' | tr -d '\r\n')"
    printf '%s' "$mac" | grep -Eq '^[0-9A-F]{2}(:[0-9A-F]{2}){5}$' || { reply 0 'Некорректный MAC'; return; }
    if [ -z "$id" ]; then id="d$(date +%s)$$"; fi
    valid_id "$id" || { reply 0 'Некорректный ID'; return; }
    [ "$enabled" = 0 ] && enabled=0 || enabled=1
    uci set "easyroute.$id=device"
    uci set "easyroute.$id.name=$name"
    uci set "easyroute.$id.mac=$mac"
    [ -n "$profile" ] && uci set "easyroute.$id.profile=$profile" || uci -q delete "easyroute.$id.profile"
    uci set "easyroute.$id.enabled=$enabled"
    uci commit easyroute
    if out="$(/usr/libexec/easyroute apply 2>&1)"; then reply 1 'Устройство сохранено и применено'; else reply 0 "$out"; fi
}

delete_device() {
    json_load "$1"; json_get_var id id; valid_id "$id" || { reply 0 'Некорректный ID'; return; }
    uci -q delete "easyroute.$id" 2>/dev/null || true; uci commit easyroute
    /usr/libexec/easyroute apply >/dev/null 2>&1 || true
    reply 1 'Устройство удалено'
}

test_route() {
    json_load "$1"; json_get_var host host; json_get_var profile profile
    host="$(printf '%s' "$host" | tr -d '\r\n' | cut -c1-255)"
    [ -n "$host" ] || { reply 0 'Введите домен или IP'; return; }
    if printf '%s' "$host" | grep -Eq '^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$'; then
        ip="$host"
    else
        ip="$(nslookup "$host" 127.0.0.1 2>/dev/null | awk '/^Address [0-9]+: /{print $3} /^Address: /{print $2}' | grep -E '^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$' | head -n1)"
    fi
    [ -n "$ip" ] || { reply 0 'DNS не вернул IPv4-адрес'; return; }
    [ -n "$profile" ] || profile="$(uci -q get easyroute.main.profile 2>/dev/null || true)"
    [ -n "$profile" ] || profile="$(vpn_ids | head -n1)"
    [ -n "$profile" ] || profile='__default'
    if [ "$profile" = '__default' ]; then mark='0x66'; iface="$(detect_iface)"; name='Основной AWG'
    else mark="$(uci -q get "easyroute.$profile.mark" 2>/dev/null || echo 0x66)"; iface="$(uci -q get "easyroute.$profile.interface" 2>/dev/null || true)"; name="$(uci -q get "easyroute.$profile.name" 2>/dev/null || echo "$profile")"; fi
    route="$(ip route get "$ip" mark "$mark" 2>/dev/null || true)"
    json_init; json_add_boolean ok 1; json_add_string host "$host"; json_add_string ip "$ip"; json_add_string profile "$name"; json_add_string interface "$iface"; json_add_string mark "$mark"; json_add_string route "$route"; json_dump
}

diagnostics() {
    json_init; json_add_boolean ok 1
    json_add_string openwrt "$(grep -o "DISTRIB_RELEASE='[^']*'" /etc/openwrt_release 2>/dev/null | cut -d"'" -f2)"
    json_add_string awg_version "$(awg --version 2>/dev/null | head -n1 || echo not-installed)"
    json_add_string firewall "$(fw4 -q check >/dev/null 2>&1 && echo OK || echo ERROR)"
    json_add_string dnsmasq "$(dnsmasq --test --conf-file=/etc/dnsmasq.conf >/dev/null 2>&1 && echo OK || echo ERROR)"
    json_add_string iface "$(detect_iface)"
    json_add_string ip_rules "$(ip rule show 2>/dev/null | tr '\n' ';' | cut -c1-1800)"
    json_add_string routes "$(ip route show table 166 2>/dev/null | tr '\n' ';' | cut -c1-1000)"
    json_add_string nft "$(nft list table inet fw4 2>/dev/null | grep -c easyroute || echo 0)"
    json_add_string log "$(tail -n 30 /tmp/easyroute-fw4.log 2>/dev/null | tr '\n' ' ' | cut -c1-1500)"
    json_dump
}

case "${1:-}" in
    list)
        json_init
        json_add_object status; json_close_object
        json_add_object list_rules; json_close_object
        json_add_object get_rule; json_add_string id String; json_close_object
        json_add_object save_rule
            json_add_string id String
            json_add_string name String
            json_add_boolean enabled Boolean
            json_add_string content String
            json_add_string source_type String
            json_add_string source_url String
            json_add_boolean auto_update Boolean
            json_add_string update_interval String
            json_add_string profile String
        json_close_object
        json_add_object profiles; json_close_object
        json_add_object save_profile
            json_add_string id String
            json_add_string name String
            json_add_string interface String
            json_add_string mark String
            json_add_string table String
            json_add_boolean enabled Boolean
        json_close_object
        json_add_object delete_profile; json_add_string id String; json_close_object
        json_add_object devices; json_close_object
        json_add_object save_device
            json_add_string id String
            json_add_string name String
            json_add_string mac String
            json_add_string profile String
            json_add_boolean enabled Boolean
        json_close_object
        json_add_object delete_device; json_add_string id String; json_close_object
        json_add_object test_route
            json_add_string host String
            json_add_string profile String
        json_close_object
        json_add_object diagnostics; json_close_object
        json_add_object delete_rule; json_add_string id String; json_close_object
        json_add_object update_rule; json_add_string id String; json_close_object
        json_add_object update_all; json_close_object
        json_add_object apply; json_close_object
        json_dump
        ;;
    call)
        method="${2:-}"; payload="$(cat)"
        case "$method" in
            status) status ;;
            list_rules) list_rules ;;
            get_rule) get_rule "$payload" ;;
            save_rule) save_rule "$payload" ;;
            delete_rule) delete_rule "$payload" ;;
            update_rule)
                json_load "$payload"; json_get_var id id
                valid_id "$id" || { reply 0 'Некорректный ID'; exit 0; }
                if out="$(/usr/libexec/easyroute-url-update one "$id" 2>&1)"; then reply 1 "$out"; else reply 0 "$out"; fi
                ;;
            update_all)
                if out="$(/usr/libexec/easyroute-url-update all 2>&1)"; then reply 1 "$out"; else reply 0 "$out"; fi
                ;;
            profiles) profiles ;;
            save_profile) save_profile "$payload" ;;
            delete_profile) delete_profile "$payload" ;;
            devices) devices ;;
            save_device) save_device "$payload" ;;
            delete_device) delete_device "$payload" ;;
            test_route) test_route "$payload" ;;
            diagnostics) diagnostics ;;
            apply)
                if out="$(/usr/libexec/easyroute apply 2>&1)"; then reply 1 'Маршруты применены'; else reply 0 "$out"; fi
                ;;
            *) reply 0 'Неизвестная команда' ;;
        esac
        ;;
esac
