#!/bin/sh

set -u

BASE='/etc/easyroute'
LISTDIR="$BASE/lists"
CFG='/etc/config/easyroute'
DNSMASQ_CONF='/etc/dnsmasq.conf'
SET_FILE='/usr/share/nftables.d/table-pre/90-easyroute-sets.nft'
MARK_FILE='/usr/share/nftables.d/chain-pre/mangle_prerouting/90-easyroute-mark.nft'
FWD_FILE='/usr/share/nftables.d/chain-pre/forward/90-easyroute-forward.nft'
NAT_FILE='/usr/share/nftables.d/table-post/90-easyroute-nat.nft'
MARK='0x66'
TABLE='166'
RULE_PRIO='1066'

log() { logger -t easyroute "$*" 2>/dev/null || true; }

get_iface() {
    local configured proto detected
    configured="$(uci -q get easyroute.main.interface 2>/dev/null || true)"
    if [ -n "$configured" ]; then
        proto="$(uci -q get "network.$configured.proto" 2>/dev/null || true)"
        if [ "$proto" = 'amneziawg' ] || ip link show "$configured" >/dev/null 2>&1 || { command -v awg >/dev/null 2>&1 && awg show "$configured" >/dev/null 2>&1; }; then
            printf '%s\n' "$configured"
            return 0
        fi
    fi
    detected="$(uci show network 2>/dev/null | sed -n "s/^network\.\([^.=]*\)\.proto='amneziawg'$/\1/p" | head -n1)"
    if [ -n "$detected" ]; then
        printf '%s\n' "$detected"
    else
        printf '%s\n' "${configured:-AWG}"
    fi
}

iface_status_json() {
    local iface="$1" out
    out="$(ifstatus "$iface" 2>/dev/null || true)"
    [ -n "$out" ] || out="$(ubus call "network.interface.$iface" status 2>/dev/null || true)"
    printf '%s' "$out"
}

get_dev() {
    local iface="$1" out dev
    out="$(iface_status_json "$iface")"
    dev="$(printf '%s' "$out" | jsonfilter -e '@.l3_device' 2>/dev/null || true)"
    [ -n "$dev" ] || dev="$(printf '%s' "$out" | jsonfilter -e '@.device' 2>/dev/null || true)"
    [ -n "$dev" ] || {
        ip link show "$iface" >/dev/null 2>&1 && dev="$iface"
    }
    [ -n "$dev" ] || dev="$iface"
    printf '%s\n' "$dev"
}

iface_up() {
    local iface="$1" out up
    out="$(iface_status_json "$iface")"
    up="$(printf '%s' "$out" | jsonfilter -e '@.up' 2>/dev/null || true)"
    [ "$up" = 'true' ] && return 0
    ip link show "$iface" >/dev/null 2>&1 && return 0
    command -v awg >/dev/null 2>&1 && awg show "$iface" >/dev/null 2>&1 && return 0
    return 1
}

vpn_ids() { uci show easyroute 2>/dev/null | sed -n "s/^easyroute\.\([^.=]*\)=vpn$/\1/p"; }
device_ids() { uci show easyroute 2>/dev/null | sed -n "s/^easyroute\.\([^.=]*\)=device$/\1/p"; }

profile_ids() {
    ids="$(vpn_ids)"
    if [ -n "$ids" ]; then printf '%s\n' "$ids"; else printf '%s\n' '__default'; fi
}
profile_num() {
    wanted="$1"; n=0
    for id in $(vpn_ids); do
        [ "$id" = "$wanted" ] && { printf '%s\n' "$n"; return; }
        n=$((n+1))
    done
    printf '%s\n' 0
}
profile_field() {
    id="$1"; field="$2"
    if [ "$id" = '__default' ]; then
        case "$field" in
            name) printf 'Основной AWG\n' ;;
            interface) get_iface ;;
            mark) printf '0x66\n' ;;
            table) printf '166\n' ;;
            enabled) printf '1\n' ;;
        esac
    else
        uci -q get "easyroute.$id.$field" 2>/dev/null || {
            case "$field" in mark) printf '0x66\n';; table) printf '166\n';; enabled) printf '1\n';; esac
        }
    fi
}
profile_for_rule() {
    id="$1"; p="$(uci -q get "easyroute.$id.profile" 2>/dev/null || true)"
    if [ -n "$p" ] && [ "$(uci -q get "easyroute.$p" 2>/dev/null || true)" = 'vpn' ]; then
        printf '%s\n' "$p"; return
    fi
    p="$(uci -q get easyroute.main.profile 2>/dev/null || true)"
    if [ -n "$p" ] && [ "$(uci -q get "easyroute.$p" 2>/dev/null || true)" = 'vpn' ]; then
        printf '%s\n' "$p"; return
    fi
    p="$(vpn_ids | head -n1)"
    [ -n "$p" ] && printf '%s\n' "$p" || printf '__default\n'
}
route_down() {
    while ip rule del priority "$RULE_PRIO" 2>/dev/null; do :; done
    while ip -6 rule del priority "$RULE_PRIO" 2>/dev/null; do :; done
    ip route flush table "$TABLE" 2>/dev/null || true
    ip -6 route flush table "$TABLE" 2>/dev/null || true
    for id in $(vpn_ids); do
        n="$(profile_num "$id")"
        m="$(profile_field "$id" mark)"
        t="$(profile_field "$id" table)"
        while ip rule del priority "$((RULE_PRIO+n))" fwmark "$m/0xff" 2>/dev/null; do :; done
        while ip -6 rule del priority "$((RULE_PRIO+n))" fwmark "$m/0xff" 2>/dev/null; do :; done
        ip route flush table "$t" 2>/dev/null || true
        ip -6 route flush table "$t" 2>/dev/null || true
    done
}
route_up() {
    local id iface dev m t n enabled
    route_down
    n=0
    for id in $(profile_ids); do
        iface="$(profile_field "$id" interface)"
        m="$(profile_field "$id" mark)"
        t="$(profile_field "$id" table)"
        enabled="$(profile_field "$id" enabled)"
        [ "$enabled" = '1' ] || { n=$((n+1)); continue; }
        iface_up "$iface" || { n=$((n+1)); continue; }
        dev="$(get_dev "$iface")"
        ip route replace default dev "$dev" table "$t" 2>/dev/null || { n=$((n+1)); continue; }
        ip rule add priority "$((RULE_PRIO+n))" fwmark "$m/0xff" lookup "$t" 2>/dev/null || true
        if ip -6 addr show dev "$dev" 2>/dev/null | grep -q 'inet6 '; then
            ip -6 route replace default dev "$dev" table "$t" 2>/dev/null || true
            ip -6 rule add priority "$((RULE_PRIO+n))" fwmark "$m/0xff" lookup "$t" 2>/dev/null || true
        fi
        n=$((n+1))
    done
}
parse_all() {
    local out="$1" id enabled file
    : > "$out"
    for id in $(list_rule_ids); do
        enabled="$(uci -q get "easyroute.$id.enabled" 2>/dev/null || echo 1)"
        [ "$enabled" = '1' ] || continue
        file="$LISTDIR/$id.txt"
        [ -s "$file" ] || continue
        awk '
        function trim(s){gsub(/^[ \t]+|[ \t]+$/, "", s); return s}
        function octok(x){return (x ~ /^[0-9]+$/ && x+0>=0 && x+0<=255)}
        function ipv4ok(s, a,n,i){n=split(s,a,"."); if(n!=4)return 0; for(i=1;i<=4;i++)if(!octok(a[i]))return 0; return 1}
        function maskbits(m, a,n,i,b,seenpartial,v){
          n=split(m,a,"."); if(n!=4)return -1; b=0; seenpartial=0;
          for(i=1;i<=4;i++){
            v=a[i]+0;
            if(seenpartial && v!=0)return -1;
            if(v==255)b+=8;
            else if(v==254){b+=7;seenpartial=1}
            else if(v==252){b+=6;seenpartial=1}
            else if(v==248){b+=5;seenpartial=1}
            else if(v==240){b+=4;seenpartial=1}
            else if(v==224){b+=3;seenpartial=1}
            else if(v==192){b+=2;seenpartial=1}
            else if(v==128){b+=1;seenpartial=1}
            else if(v==0){seenpartial=1}
            else return -1;
          }
          return b
        }
        {
          gsub(/\r/, "", $0); line=trim($0);
          if(line=="" || line ~ /^#/) next;
          sub(/[ \t]+#.*/, "", line); line=trim(line); if(line=="")next;

          if(line ~ /^route[ \t]+add[ \t]+/){
            n=split(line,a,/[ \t]+/);
            if(n>=6 && a[1]=="route" && a[2]=="add" && a[4]=="mask" && ipv4ok(a[3])){
              p=maskbits(a[5]); if(p>=0){print "4\t" a[3] "/" p; next}
            }
            print "X\t" line; next;
          }

          if(line ~ /^domain:/) sub(/^domain:/,"",line);
          else if(line ~ /^full:/) sub(/^full:/,"",line);
          else if(line ~ /^(keyword|regexp|include):/){print "U\t" line; next}

          # URL-списки OpenCCK могут возвращать wildcard-домены (*.example.com).
          # Для dnsmasq достаточно базового домена: он охватывает и поддомены.
          sub(/^\*\./,"",line);
          sub(/^\./,"",line);

          raw=line; n=split(line,a,/[ \t]+/);
          if(n>1 && a[2] !~ /^@/){print "X\t" raw; next}
          line=a[1]; line=trim(line);
          if(line=="")next;

          if(index(line,"/")>0 && line !~ /:/){
            n=split(line,b,"/");
            if(n==2 && ipv4ok(b[1]) && b[2] ~ /^[0-9]+$/ && b[2]+0<=32){print "4\t" line; next}
          }
          if(ipv4ok(line)){print "4\t" line; next}
          if(index(line,":")>0){print "6\t" line; next}
          if(line ~ /^[A-Za-z0-9_.-]+$/ && line !~ /^\./ && line !~ /\.\./){print "D\t" tolower(line); next}
          print "X\t" line
        }' "$file" >> "$out"
    done
}

join_elements() {
    local file="$1" first=1 v
    while IFS= read -r v; do
        [ -n "$v" ] || continue
        if [ "$first" -eq 1 ]; then
            printf '%s' "$v"
            first=0
        else
            printf ', %s' "$v"
        fi
    done < "$file"
}

generate_files() {
    local tmp="$1" iface dev parsed domains ip4 ip6 unsupported invalid pnum p set4 set6 setm
    local pids id rule f4 f6 fd fm mac dp fallback
    pids="$(profile_ids)"
    : > "$tmp/dnsmasq-domains"
    : > "$tmp/all-domain-count"
    : > "$tmp/all-ip-count"
    : > "$tmp/all-unsupported"
    : > "$tmp/all-invalid"

    printf '%s\n' '# Generated by EasyRoute. Do not edit.' > "$tmp/sets.nft"
    printf '%s\n' '# Generated by EasyRoute. Do not edit.' > "$tmp/mark.nft"
    printf '%s\n' '# Generated by EasyRoute. Do not edit.' > "$tmp/forward.nft"
    printf '%s\n' '# Generated by EasyRoute. Do not edit.' > "$tmp/nat.nft"

    for p in $pids; do
        iface="$(profile_field "$p" interface)"
        enabled="$(profile_field "$p" enabled)"
        [ "$enabled" = '1' ] || continue
        m="$(profile_field "$p" mark)"
        pnum="$(profile_num "$p")"
        if [ "$p" = '__default' ]; then
            set4='easyroute4'; set6='easyroute6'; setm='easyroute_mac'
        else
            set4="easyroute4p$pnum"; set6="easyroute6p$pnum"; setm="easyroute_macp$pnum"
        fi
        echo "set $set4 { type ipv4_addr; flags interval; auto-merge; }" >> "$tmp/sets.nft"
        echo "set $set6 { type ipv6_addr; flags interval; auto-merge; }" >> "$tmp/sets.nft"
        echo "set $setm { type ether_addr; }" >> "$tmp/sets.nft"

        f4="$tmp/$set4"; f6="$tmp/$set6"; fd="$tmp/$set4.domains"; fm="$tmp/$setm"
        : > "$f4"; : > "$f6"; : > "$fd"; : > "$fm"

        for rule in $(list_rule_ids); do
            [ "$(uci -q get "easyroute.$rule.enabled" 2>/dev/null || echo 1)" = '1' ] || continue
            [ "$(profile_for_rule "$rule")" = "$p" ] || continue
            [ -s "$LISTDIR/$rule.txt" ] || continue
            parsed="$tmp/$rule.$pnum.parsed"
            parse_all "$parsed"
            awk -F '\t' '$1=="4"{print $2}' "$parsed" >> "$f4"
            awk -F '\t' '$1=="6"{print $2}' "$parsed" >> "$f6"
            awk -F '\t' '$1=="D"{print $2}' "$parsed" >> "$fd"
            awk -F '\t' '$1=="U"{print $2}' "$parsed" >> "$tmp/all-unsupported"
            awk -F '\t' '$1=="X"{print $2}' "$parsed" >> "$tmp/all-invalid"
        done

        sort -u "$f4" -o "$f4"
        sort -u "$f6" -o "$f6"
        sort -u "$fd" -o "$fd"

        if [ -s "$f4" ]; then
            printf 'add element inet fw4 %s { ' "$set4" >> "$tmp/sets.nft"
            join_elements "$f4" >> "$tmp/sets.nft"
            echo ' }' >> "$tmp/sets.nft"
        fi
        if [ -s "$f6" ]; then
            printf 'add element inet fw4 %s { ' "$set6" >> "$tmp/sets.nft"
            join_elements "$f6" >> "$tmp/sets.nft"
            echo ' }' >> "$tmp/sets.nft"
        fi

        for id in $(device_ids); do
            [ "$(uci -q get "easyroute.$id.enabled" 2>/dev/null || echo 1)" = '1' ] || continue
            dp="$(uci -q get "easyroute.$id.profile" 2>/dev/null || true)"
            [ -n "$dp" ] || dp="$(uci -q get easyroute.main.profile 2>/dev/null || true)"
            [ -n "$dp" ] || dp="$(vpn_ids | head -n1)"
            [ -n "$dp" ] || dp='__default'
            [ "$dp" = "$p" ] || continue
            mac="$(uci -q get "easyroute.$id.mac" 2>/dev/null || true)"
            [ -n "$mac" ] && printf '%s\n' "$mac" >> "$fm"
        done
        sort -u "$fm" -o "$fm"
        if [ -s "$fm" ]; then
            printf 'add element inet fw4 %s { ' "$setm" >> "$tmp/sets.nft"
            join_elements "$fm" >> "$tmp/sets.nft"
            echo ' }' >> "$tmp/sets.nft"
        fi

        if [ -s "$fd" ]; then
            awk -v s4="$set4" -v s6="$set6" '
                BEGIN{line="";n=0}
                {
                    if(n==0)line="nftset=/";else line=line"/";
                    line=line$0;n++;
                    if(n>=30){print line"/4#inet#fw4#"s4",6#inet#fw4#"s6;line="";n=0}
                }
                END{if(line!="")print line"/4#inet#fw4#"s4",6#inet#fw4#"s6}
            ' "$fd" >> "$tmp/dnsmasq-domains"
        fi

        echo "ip daddr @$set4 meta mark set $m" >> "$tmp/mark.nft"
        echo "ip6 daddr @$set6 meta mark set $m" >> "$tmp/mark.nft"
        echo "ether saddr @$setm meta mark set $m" >> "$tmp/mark.nft"

        if iface_up "$iface"; then
            dev="$(get_dev "$iface")"
            echo "meta mark $m oifname \"$dev\" accept" >> "$tmp/forward.nft"
            echo "chain easyroute_srcnat_$set4 { type nat hook postrouting priority 101; policy accept; meta mark $m oifname \"$dev\" masquerade; }" >> "$tmp/nat.nft"
        else
            fallback="$(uci -q get easyroute.main.fallback 2>/dev/null || echo wan)"
            if [ "$fallback" = 'block' ]; then
                echo "ip daddr @$set4 drop" >> "$tmp/forward.nft"
                echo "ip6 daddr @$set6 drop" >> "$tmp/forward.nft"
            fi
        fi
        wc -l < "$fd" >> "$tmp/all-domain-count"
        expr "$(wc -l < "$f4") + $(wc -l < "$f6")" >> "$tmp/all-ip-count"
    done

    awk 'BEGIN{skip=0}/^# EASYROUTE-BEGIN$/{skip=1;next}/^# EASYROUTE-END$/{skip=0;next}skip==0{print}' "$DNSMASQ_CONF" > "$tmp/dnsmasq.conf"
    {
        echo '# EASYROUTE-BEGIN'
        echo '# Generated by EasyRoute. Do not edit.'
        cat "$tmp/dnsmasq-domains"
        echo '# EASYROUTE-END'
    } >> "$tmp/dnsmasq.conf"

    domain_count="$(awk '{s+=$1}END{print s+0}' "$tmp/all-domain-count" 2>/dev/null)"
    ip_count="$(awk '{s+=$1}END{print s+0}' "$tmp/all-ip-count" 2>/dev/null)"
    unsupported_count="$(wc -l < "$tmp/all-unsupported" | tr -d ' ')"
    invalid_count="$(wc -l < "$tmp/all-invalid" | tr -d ' ')"
    printf '%s\n' "$domain_count" > "$tmp/domain_count"
    printf '%s\n' "$ip_count" > "$tmp/ip_count"
    printf '%s\n' "$unsupported_count" > "$tmp/unsupported_count"
    printf '%s\n' "$invalid_count" > "$tmp/invalid_count"
}
install_generated() {
    local tmp="$1" rollback="$tmp/rollback" f rel
    mkdir -p "$rollback"
    for f in "$SET_FILE" "$MARK_FILE" "$FWD_FILE" "$NAT_FILE" "$DNSMASQ_CONF"; do
        rel="$(printf '%s' "$f" | sed 's#/#_#g')"
        if [ -e "$f" ]; then cp -p "$f" "$rollback/$rel"; else : > "$rollback/$rel.absent"; fi
    done

    mkdir -p "$(dirname "$SET_FILE")" "$(dirname "$MARK_FILE")" "$(dirname "$FWD_FILE")" "$(dirname "$NAT_FILE")"
    cp "$tmp/sets.nft" "$SET_FILE"
    cp "$tmp/mark.nft" "$MARK_FILE"
    cp "$tmp/forward.nft" "$FWD_FILE"
    cp "$tmp/nat.nft" "$NAT_FILE"
    cp "$tmp/dnsmasq.conf" "$DNSMASQ_CONF"

    if ! fw4 -q check >/dev/null 2>&1; then
        rollback_generated "$rollback"
        echo 'Ошибка проверки nftables. Изменения отменены.' >&2
        return 1
    fi

    if ! dnsmasq --test --conf-file="$DNSMASQ_CONF" >/dev/null 2>&1; then
        rollback_generated "$rollback"
        echo 'Ошибка проверки dnsmasq. Изменения отменены.' >&2
        return 1
    fi

    if ! fw4 reload >/dev/null 2>&1; then
        rollback_generated "$rollback"
        fw4 reload >/dev/null 2>&1 || true
        echo 'Не удалось применить firewall. Изменения отменены.' >&2
        return 1
    fi

    route_up || true

    if ! /etc/init.d/dnsmasq restart >/dev/null 2>&1 || ! pidof dnsmasq >/dev/null 2>&1; then
        rollback_generated "$rollback"
        fw4 reload >/dev/null 2>&1 || true
        /etc/init.d/dnsmasq restart >/dev/null 2>&1 || true
        route_up || true
        echo 'dnsmasq не запустился. Изменения отменены.' >&2
        return 1
    fi
    return 0
}

rollback_generated() {
    local rollback="$1" f rel
    for f in "$SET_FILE" "$MARK_FILE" "$FWD_FILE" "$NAT_FILE" "$DNSMASQ_CONF"; do
        rel="$(printf '%s' "$f" | sed 's#/#_#g')"
        if [ -e "$rollback/$rel.absent" ]; then
            rm -f "$f"
        elif [ -e "$rollback/$rel" ]; then
            cp -p "$rollback/$rel" "$f"
        fi
    done
}

apply_all() {
    local tmp="/tmp/easyroute.apply.$$" rc=0
    mkdir -p "$tmp"
    generate_files "$tmp" || { rm -rf "$tmp"; return 1; }
    if install_generated "$tmp"; then
        mkdir -p /tmp/easyroute
        cp "$tmp/domain_count" /tmp/easyroute/domain_count
        cp "$tmp/ip_count" /tmp/easyroute/ip_count
        cp "$tmp/unsupported_count" /tmp/easyroute/unsupported_count
        cp "$tmp/invalid_count" /tmp/easyroute/invalid_count
        date '+%Y-%m-%d %H:%M:%S' > /tmp/easyroute/last_apply
        rc=0
    else
        rc=1
    fi
    rm -rf "$tmp"
    return "$rc"
}

case "${1:-}" in
    apply) apply_all ;;
    route) route_up ;;
    route-down) route_down ;;
    *) echo "Usage: $0 apply|route|route-down"; exit 2 ;;
esac
